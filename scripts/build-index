#!/usr/bin/env python3
"""Regenerate root index.html from lessons/ and reference/.

Idempotent: a second run produces an identical file, so the pre-commit hook
can always stage index.html without introducing churn.
"""
import html
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SECTIONS = ("Lessons", "Reference")
TITLE_RE = re.compile(r"<title>(.*?)</title>", re.S)


def page_title(path: Path) -> str:
    m = TITLE_RE.search(path.read_text(encoding="utf-8"))
    if not m:
        sys.exit(f"error: no <title> in {path}")
    return m.group(1).strip()


def sort_key(path: Path):
    n = re.match(r"(\d+)", path.stem)
    return (0, int(n.group(1))) if n else (1, path.stem.lower())


def section_html(name: str) -> str:
    files = sorted((ROOT / name.lower()).glob("*.html"), key=sort_key)
    if not files:
        return ""
    label = "Lekcje" if name == "Lessons" else "Ściągi"
    items = "\n".join(
        f'      <li><a href="{name.lower()}/{p.name}">{html.escape(page_title(p))}</a></li>'
        for p in files
    )
    return f'    <h2>{label}</h2>\n    <ol class="index-list">\n{items}\n    </ol>'


def main() -> None:
    rendered = [h for s in SECTIONS if (h := section_html(s))]
    sections = "\n\n".join(rendered)
    page = f"""<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#ebe6dc">
  <title>Nauka polskiego · Spis</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="assets/vendor/pico.conditional.min.css">
  <link rel="stylesheet" href="assets/style.css">
  <style>
    body.pico.index-page {{
      width: min(100% - 2.5rem, 46rem);
      margin: 0 auto;
      padding: clamp(2rem, 6vw, 5rem) 0 6rem;
      background: var(--canvas);
      color: var(--ink);
      font-family: var(--sans);
    }}
    .index-page .index-shell {{
      padding: clamp(1.5rem, 5vw, 3rem);
      border: 1px solid var(--rule);
      background: var(--paper);
    }}
    .index-page h1 {{
      margin: 0 0 0.25rem;
      color: var(--accent-dark);
      font-family: var(--display-serif);
      font-size: clamp(1.9rem, 5vw, 2.8rem);
      line-height: 1.05;
    }}
    .index-page .index-kicker {{
      margin: 0 0 0.35rem;
      color: var(--accent);
      font-family: var(--mono);
      font-size: 0.85rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }}
    .index-page .index-purpose {{
      margin: 0 0 1.25rem;
      color: var(--muted);
      font-family: var(--serif);
    }}
    .index-page h2 {{
      margin: 1.8rem 0 0.6rem;
      padding-bottom: 0.3rem;
      border-bottom: 1px solid var(--rule);
      color: var(--ink);
      font-family: var(--serif);
      font-size: 1.2rem;
    }}
    .index-page .index-list {{
      margin: 0;
      padding-left: 1.25rem;
    }}
    .index-page .index-list li {{
      margin: 0.45rem 0;
    }}
    .index-page a {{
      color: var(--accent);
      text-decoration-color: currentColor;
      text-underline-offset: 0.15em;
    }}
    .index-page a:hover {{
      color: var(--accent-dark);
    }}
    .index-page .index-foot {{
      margin-top: 2.5rem;
      padding-top: 0.8rem;
      border-top: 1px solid var(--rule);
      color: var(--muted);
      font-size: 0.9rem;
    }}
  </style>
</head>
<body class="pico index-page">
  <div class="index-shell">
    <p class="index-kicker">Nauka polskiego · Spis</p>
    <h1>Gramatyka polska</h1>
    <p class="index-purpose">Kurs przypadków i powiązanych tematów: lekcje i ściągi.</p>

{sections}

    <p class="index-foot">Wygenerowano przez scripts/build-index. Dodaj lekcję, a spis zaktualizuje się sam.</p>
  </div>
</body>
</html>
"""
    target = ROOT / "index.html"
    old = target.read_text(encoding="utf-8") if target.exists() else None
    if old != page:
        target.write_text(page, encoding="utf-8")
        print(f"build-index: wrote {target.relative_to(ROOT)}")
    else:
        print("build-index: index.html unchanged")


if __name__ == "__main__":
    main()
